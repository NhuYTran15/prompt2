{
  "name": "ecommerce-mvp-api",
  "version": "1.0.0",
  "private": true,
  "description": "RESTful API MVP for an e-commerce system",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "prisma db seed",
    "test": "node --test"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "bcryptjs": "3.0.2",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "morgan": "1.12.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "prisma": "6.12.0",
    "supertest": "7.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
